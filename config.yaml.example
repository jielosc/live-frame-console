# Live Frame Console - Model Configuration
# Copy this file to config.yaml and edit as needed.
# config.yaml is git-ignored to avoid leaking sensitive info.

# Default provider (can be overridden by ?provider= query param)
default_provider: local-qwen

providers:
  # WebSocket protocol — bidirectional streaming (e.g. Qwen realtime server)
  local-qwen:
    protocol: ws
    ws_url: "ws://127.0.0.1:8000/ws/realtime"

  # OpenAI-compatible HTTP protocol — any /v1/chat/completions endpoint
  # Add as many as you need with custom names:
  #
  # siliconflow:
  #   protocol: http
  #   base_url: "https://api.siliconflow.cn"
  #   model: "Qwen/Qwen3-VL-8B-Instruct"
  #   api_key: "sk-..."
  #   max_frames: 24
